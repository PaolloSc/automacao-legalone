# ---------- LegalOne Login ----------
LEGALONE_USERNAME=seu_email@exemplo.com
LEGALONE_PASSWORD=
LEGALONE_LOGIN_URL=https://seu-escritorio.novajus.com.br/

# ---------- APIs externas ----------
FIRECRAWL_API_KEY=
GROQ_API_KEY=
# DataJud usa chave publica do CNJ por padrao; so preencha para sobrescrever.
DATAJUD_API_KEY=
# Azure Document Intelligence (Opcao B - webhook OCR)
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# ---------- LegalOne API REST ----------
# Ative o cadastro via API (em vez do navegador):
LEGALONE_USE_API=false
# OAuth client_credentials (obtenha client_id/secret junto a Thomson Reuters / suporte LegalOne)
LEGALONE_API_CLIENT_ID=
LEGALONE_API_CLIENT_SECRET=
# URL de obtencao do token OAuth (confirmado em developers.thomsonreuters.com > Legal One Firms Brazil > Authentication)
LEGALONE_API_TOKEN_URL=https://api.thomsonreuters.com/legalone/oauth?grant_type=client_credentials
# Base dos recursos REST (confirmado na doc oficial em 27/08/2026)
LEGALONE_API_BASE=https://api.thomsonreuters.com/legalone/v1/api/rest
# IDs padrao do escritorio (preencha apos validar via smoke test; evitam lookups em runtime)
LEGALONE_DEFAULT_STATUS_ID=
LEGALONE_DEFAULT_AREA_ID=
# Depuracao: grava POSTs do LegalOne em docs/varredura/requests_legalone.jsonl.
# Opt-in, so' em dev — nunca em producao.
LEGALONE_ESPIAR=0

# ---------- Teams: validacao pos-cadastro ----------
# URL do gatilho HTTP do fluxo no Power Automate (docs/FLUXO_TEAMS_VALIDACAO.md).
# Sem isso, a notificacao e' pulada silenciosamente (log de info, nao erro).
TEAMS_VALIDACAO_FLOW_URL=
